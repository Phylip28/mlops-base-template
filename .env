# MLOps Platform — Environment Variables
# Configuration for local development

# ── CORS Configuration ─────────────────────────────────────────────
# Add your university/public IP here when accessing from outside localhost
# Get your IP with: curl ifconfig.me
CORS_ORIGINS=http://localhost:8000,http://localhost:8001,http://localhost:8502,http://179.1.108.98:8001

# ── MLflow Configuration ────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minio_user
AWS_SECRET_ACCESS_KEY=minio_password

# ── API Configuration ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Prediction UI Configuration ─────────────────────────────────────
PREDICTION_UI_PORT=8001

# ── Streamlit Control Dashboard ─────────────────────────────────────
STREAMLIT_PORT=8502
