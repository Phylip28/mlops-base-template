# MLOps Platform — Environment Variables
# Copy this file to .env and configure for your environment

# ── CORS Configuration ─────────────────────────────────────────────
# Comma-separated list of allowed origins for cross-origin requests
# Required when accessing from different networks (e.g., university, remote)
#
# Development (localhost only):
# CORS_ORIGINS=http://localhost:8000,http://localhost:8001,http://localhost:8502
#
# Production (with specific domain):
# CORS_ORIGINS=https://yourdomain.com,http://localhost:8000
#
# Mixed (development + remote access):
# Get your public IP with: curl ifconfig.me
# CORS_ORIGINS=http://localhost:8000,http://localhost:8001,http://<YOUR_IP>:8001
CORS_ORIGINS=

# ── MLflow Configuration ────────────────────────────────────────────
# MLflow tracking server URL
MLFLOW_TRACKING_URI=http://localhost:5000

# S3-compatible storage for MLflow artifacts (MinIO)
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minio_user
AWS_SECRET_ACCESS_KEY=minio_password

# ── API Configuration ───────────────────────────────────────────────
# FastAPI server host and port
API_HOST=0.0.0.0
API_PORT=8000

# ── Prediction UI Configuration ─────────────────────────────────────
# Prediction UI server port
PREDICTION_UI_PORT=8001

# ── Streamlit Control Dashboard ─────────────────────────────────────
# Streamlit dashboard port
STREAMLIT_PORT=8502
